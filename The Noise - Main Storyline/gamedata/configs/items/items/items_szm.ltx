; Stage 12: the crashed helicopter. Same model and setup as the vanilla Pripyat wreck
; (pri_a28_earth_helli_1) without its story_id; spawned with alife_create like New Tasks' static heli.
[szm_heli_wreck]
GroupControlSection     = spawn_group
$spawn                  = "dynamic_objects\scene_objects\szm_heli_wreck"
$prefetch               = 8
class                   = O_PHYSIC
remove_time             = 60
script_binding          = bind_physic_object.init
visual                  = dynamics\vehicles\mi24\veh_mi24_u_02.ogf
startup_animation       = idle
fixed_bones             = korpus1

