; Szum - main storyline
; Auto-included by items\items\base.ltx (#include "items_*.ltx").
; Quest items: quest_item = true keeps bodies carrying them from being cleaned up and stops NPC looting.
; Based on Spore's vanilla task PDA (mar_base_owl_stalker_trader_task_1_pda).

[szm_quest_base]:tch_quest
$spawn                  = "quest_items\szm_quest_base"
kind                    = i_quest
visual                  = dynamics\devices\dev_pda\dev_pda.ogf
can_trade               = false
quest_item              = true
cost                    = 0
icons_texture           = ui\ui_szm_icons
inv_grid_width          = 1
inv_grid_height         = 1
inv_grid_x              = 0
inv_grid_y              = 0
upgr_icon_path          = ui\actor_items\ui_actor_items_1
upgr_icon_x             = 150
upgr_icon_y             = 0
upgr_icon_width         = 150
upgr_icon_height        = 100

; Stage 2-6: part of the courier's package
[szm_cylinder]:szm_quest_base
inv_grid_x              = 4
inv_grid_y              = 0
inv_grid_width          = 1
inv_grid_height         = 2
$spawn                  = "quest_items\szm_cylinder"
inv_name                = szm_cylinder_name
inv_name_short          = szm_cylinder_name
description             = szm_cylinder_descr
inv_weight              = 1.2

