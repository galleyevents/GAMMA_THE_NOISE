-- Act V timing: only the first stage waits. ACT5_TEST_DELAY (real seconds) overrides it for testing;
-- nil for a release. A stage that fails to start (no spawn smart, giver away) is retried a minute later.
ACT5_FIRST_DELAY_H = 24   -- in-game hours from the Act IV choice to the first Act V stage
ACT5_TEST_DELAY    = nil
ACT5_FIRST = { cold = 17, sid = 19, wolf = 21 }

-- Who calls on the radio
GIVER_RADIO = {
	[COLD] = { name = "szm_name_cold", icon = "ui_inGame2_cold" },
	[SID]  = { name = "szm_name_sid",  icon = "ui_inGame2_sid" },
	[WOLF] = { name = "szm_name_wolf", icon = "ui_inGame2_wolf" },
}

-- Who offers each stage: after a stage is turned in, this NPC gets a map spot until the next offer is accepted
OFFER_AT = {
	[2] = SID,   [3] = SID,   [4] = SID,   [5] = SID,   [6] = SID,
	[7] = SPORE, [8] = SPORE, [9] = SPORE, [10] = SPORE, [11] = SPORE,
	[12] = COLD, [13] = COLD,
	[14] = SID,  [15] = SID,
}
-- Gold like the story task markers (own type, defined in modxml_szm.script, so removing it
-- never takes away the task's own marker on the same NPC)
OFFER_SPOT = "szm_story_location"
OLD_OFFER_SPOT = "secondary_task_location"   -- used before; removed from our NPCs in older saves

-- Spawn smarts used by the last few stages are skipped, so consecutive tasks don't share a location
RECENT_SMARTS = 6

-- Leash for the stalkers of the stage squads: they ignore enemies (a stray dog, a passing squad)
-- that are further than LEASH_RADIUS from their spawn smart, unless the enemy is within
-- SELF_DEFENSE_RADIUS of them. The actor and the actor's companions are never ignored.
-- Without enemies they walk back to the smart (scripted_target), so they don't scatter over the map.
LEASH_RADIUS        = 60
SELF_DEFENSE_RADIUS = 20

-- Story squads with relationship = enemy must fight the actor of any faction. The squad script sets a
-- personal goodwill of -1000 once, which a positive faction relation (the table, or GAMMA's dynamic one)
-- plus rank and reputation can outweigh: an NPC is an enemy only at an attitude of -999 or less.
-- So each member gets HOSTILE_GOODWILL at spawn, and the status functor sets it again on any member
-- that doesn't treat the actor as an enemy.
HOSTILE_GOODWILL = -10000

-- Stage 24's transmitter: a field radio station - TRANSMITTER_PROP (the generator, the part that is used)
-- and TRANSMITTER_PARTS around it, { section, x, z offset in m }. While its module is in and the actor is
-- within TRANSMITTER_FX_DIST, looping effects play at the generator (TRANSMITTER_PARTICLES), at every part
-- (all of TRANSMITTER_PART_PARTICLES) and at TRANSMITTER_FX_SPOTS around the generator (TRANSMITTER_SPOT_PARTICLES).
-- TRANSMITTER_LEVEL is where it stands (it goes away when the actor leaves with the module).
-- Particle names must exist in particles.xr: a missing one is a fatal engine error. These are in both
-- particles.xr files of G.A.M.M.A. (Particles Cinematic VFX, Boomsticks and Sharpsticks).
TRANSMITTER_PROP      = "szm_transmitter_station"   -- (szm_transmitter: the old antenna, kept for saves)
TRANSMITTER_PARTS     = {
	{ "szm_transmitter_radio",      1.3,  0.4 },
	{ "szm_transmitter_scanner_1", -1.3,  0.8 },
	{ "szm_transmitter_scanner_2", -1.2, -0.9 },
}
TRANSMITTER_PARTICLES      = { "anomaly2\\electra_idle", "anomaly2\\generatory" }
TRANSMITTER_PART_PARTICLES = { "anomaly2\\electra_idle" }
TRANSMITTER_SPOT_PARTICLES = { "anomaly2\\electra_idle" }
TRANSMITTER_FX_SPOTS  = { { 1.6, -0.6 }, { -1.6, -0.2 }, { 0.3, 1.9 }, { -0.2, -1.9 } }
-- Looping 3D sound at the generator, same rules as the effects: the Noise itself (snd_hum's file)
TRANSMITTER_SOUNDS    = { "radio\\white_noise\\white_noise_heavy" }
TRANSMITTER_SOUND_DIST = { 3, 45 }   -- full volume within the first, silent beyond the second (m)
TRANSMITTER_SOUND_VOLUME = 1.0
TRANSMITTER_FX_DIST   = 150
TRANSMITTER_LEVEL     = "l03u_agr_underground"
-- The model's collision is low down, so it is used by standing within TRANSMITTER_USE_DIST (m) of it and
-- pressing the use key (a hint shows there); aiming at it and using it works too
TRANSMITTER_USE_DIST  = 5

-- Act IV rewards; money/goodwill in tm_szm.ltx is common, the rest is here
CHOICES = {
	cold = { info = "szm_end_cold", rewards = { {"@gear", "outfit"}, {"@medkit", 3} },   -- CS-2a or better
	         hardcore_money = 5000,   -- only in the no_gear / money_only reward modes, instead of the armor
	         goodwill = { {"csky", 200} } },
	sid  = { info = "szm_end_sid",  rewards = { {"@gear", "weapon", ammo = 3} },   -- SKS or better, pristine
	         money = 15000, goodwill = { {"csky", -300} } },
	wolf = { info = "szm_end_wolf", rewards = { {"af_soul", 1}, {"@medkit", 2} },
	         goodwill = { {"stalker", 150}, {"csky", 50} } },
}

---------------------------< Scaled rewards >---------------------------
-- "@gear" rewards: what the giver can hand out, per category. Sorted by cost at runtime, sections missing
-- from the game are skipped (logged), the most expensive one is the cap. The actor gets the first one
-- that costs more than UPGRADE_MARGIN x the best item of that category the actor has had equipped;
-- if even the cap isn't, money instead: CASH_SWAP_RATIO x the cap's cost.
GEAR_TIERS = {
	weapon   = { "wpn_sks_b", "wpn_ak74", "wpn_abakan" },
	outfit   = { "cs_light_outfit", "cs_medium_outfit" },   -- CS-2a (light), CS-3a (medium); no CS-3b: endgame heavy
	backpack = { "itm_backpack" },
}
UPGRADE_MARGIN  = 1.2
-- Outfits are compared by class first ("kind"; in GAMMA a medium suit can cost less than a light one),
-- then by cost within the class
OUTFIT_CLASS = { o_light = 1, o_medium = 2, o_sci = 3, o_heavy = 3 }
CASH_SWAP_RATIO = 0.6

-- Weapons only: an actor who has outgrown GEAR_TIERS.weapon still gets a clearly better gun, from this
-- list (beyond the usual cap), but worn: the barrel (the weapon's own condition, and any part named
-- "barrel") pristine, every other part at WORN_PART_MIN..WORN_PART_MAX %. Outgrown this list too: money.
GEAR_OVERFLOW = {
	weapon = { "wpn_sig550", "wpn_g36", "wpn_groza", "wpn_val", "wpn_fn2000" },
}
WORN_PART_MIN = 40
WORN_PART_MAX = 80

-- Reward modes, picked in the installer (FOMOD: configs\mod_system_szm_mode.ltx, [szm_settings] reward_mode)
-- and changeable in MCM ("The Noise"). Money, quest items and the items a stage needs always stay.
--   full       : everything
--   no_gear    : money, ammo, medicine, artifacts - no gear, no Sid's advance (the TOZ)
--   money_only : money and artifacts
-- Reward lines with a <id>_nogear (any hardcore mode) or <id>_money (money_only) text use it.
REWARD_KEEP = {
	no_gear    = { ammo = true, medical = true, artefact = true },
	money_only = { artefact = true },
}

-- If the scaled rewards fail at runtime (an engine function or a config this game doesn't have), the
-- error goes to the log and the stage gives these fixed rewards instead, with unscaled money
FIXED_GEAR = {
	weapon   = { "wpn_sks_b", 1, pristine = true },
	outfit   = { "cs_light_outfit", 1 },
	backpack = { "itm_backpack", 1 },
}

-- Gear level 0-3: the highest weapon or outfit tier the actor's best equipped item is worth.
-- It scales the money of every stage (szm_reward_money) and the medkit type of "@medkit".
MONEY_MULT = { [0] = 1.0, [1] = 1.25, [2] = 1.5, [3] = 2.0 }
MEDKITS    = { [0] = "medkit", [1] = "medkit", [2] = "medkit_army", [3] = "medkit_scientic" }

-- Each boar of the stage 2 squad is guaranteed at least this many legs when butchered
BOAR_LEGS_PER_BOAR = 2
BOAR_STAGE = 2

-- Escort companions are raised to at least this rank: "experienced" (rating in game_relations.ltx);
-- their profile (sim_default_csky_2) can also roll a "trainee"
ESCORT_MIN_RANK = 6500
ESCORT_RANK_SPREAD = 2000

-- Pristine weapons: condition of every part (%). "G.A.M.M.A. Guns Have No Condition" keeps all guns
-- at 0.83; matching it stops item_parts.evaluate_parts from re-rolling the parts on pick-up.
PRISTINE_PART_CON = 100
local function pristine_wpn_cond()
	return grok_gun_condition_fixed and grok_gun_condition_fixed.cond or 1
end

FALLBACK_AMMO = "ammo_12x70_buck"    -- "@ammo" without a firearm in the slots

-- Corpses are placed at least this far (m) from any anomaly (static or dynamic, e.g. DRX "Arrival")
ANOMALY_SAFE_DIST     = 15
ANOMALY_SAFE_DIST_RAD = 30

-- Jellyfish spot: the anomaly field Fanatic's tutorial uses (dialogs_mlr.spawn_1_11_af_medusa_kmb)
MEDUSA_SPAWN = { pos = {-249.45230102539, -13.491371154785, -29.858497619629}, lvid = 12990, gvid = 386 }

DETECTORS = { "detector_simple", "detector_advanced", "detector_elite", "detector_scientific", "detector_grizzly" }

-- Factions the story is for. Every hostile story squad has relationship = enemy (squad_descr_szm.ltx),
-- so it fights the actor whatever the actor's faction thinks of it. A Clear Sky actor can't sell the
-- Kamerton to Sid (no dialog, radio message or map spot from him) and gets the "_csky" texts.
ALLOWED_COMMUNITIES = {
	actor_stalker = true, actor_dolg = true, actor_freedom = true, actor_ecolog = true, actor_csky = true,
}

-- Prologue starts this many seconds after a loner is in Cordon (new game, loaded save or arrival),
-- so Sid's call doesn't get lost while the player is still sorting the inventory
PROLOGUE_DELAY = 60

---------------------------< Save vars / infos >---------------------------
local function var_squad(n)  return "szm_squad_" .. n end
local function var_carrier(n) return "szm_carrier_" .. n end   -- squad member carrying the fetch item
local function var_corpse(n) return "szm_corpse_" .. n end
local function var_strike(n) return "szm_strike_" .. n end   -- { phase = "pending"|"goto"|"fight", meet, reveal_corpse }
local function var_escort(n) return "szm_escort_" .. n end   -- id of the companion squad
local function escort_info(n) return "szm_escort_given_" .. n end   -- given once, dead companions don't come back
local VAR_BOARS    = "szm_boar_ids"
local VAR_MEDUSA   = "szm_medusa_id"
local VAR_END_TIME = "szm_end_time"     -- game time of the choice
local VAR_NEXT     = "szm_next_stage"   -- Act V: { n, t = game time it was scheduled, delay = seconds }
local VAR_USED     = "szm_used_smarts"  -- names of recently used spawn smarts
local VAR_SPOT     = "szm_offer_spot"   -- id of the NPC carrying the "next offer" map spot
local VAR_GEAR     = "szm_best_gear"    -- { weapon = cost, outfit = cost, backpack = cost }: best ever equipped
local VAR_TRANSMITTER = "szm_transmitter" -- { prop = id, parts = { ids }, n = stage, taken = true once the module is out }

local function done_info(n)  return "szm_stage_" .. n .. "_done" end
local INFO_STARTED  = "szm_started"
local INFO_CHOICE_MSGS = "szm_choice_msgs_sent"
local INFO_EPILOGUE = "szm_epilogue_done"   -- old saves: the epilogue message was already sent
local INFO_ACT5     = "szm_act5_started"

---------------------------< Helpers >---------------------------
local function get_task(n)
	local task_id = STAGES[n].task
	if db.actor:get_task(task_id, true) == nil then return end
	return task_manager.get_task_manager().task_info[task_id]
end

local function count_items(section)
	local cnt = 0
	local multiuse = IsItem("multiuse", section)
	db.actor:iterate_inventory(function(owner, obj)
		if obj:section() == section then
			cnt = cnt + (multiuse and obj:get_remaining_uses() or 1)
		end
	end, db.actor)
	return cnt
end

local function has_fetch(n)
	local fetch = STAGES[n].fetch
	return count_items(fetch[1]) >= fetch[2]
end

local function actor_is_csky()
	return db.actor ~= nil and character_community(db.actor) == "actor_csky"
end

-- Reward mode: MCM if it has one, else the installer's choice, else "full"
local function installed_mode()
	local m = ini_sys:r_string_ex("szm_settings", "reward_mode")
	return (m == "full" or REWARD_KEEP[m]) and m or "full"
end

local function reward_mode()
	if ui_mcm and ui_mcm.get then
		local ok, m = pcall(ui_mcm.get, "szm/reward_mode")
		if ok and (m == "full" or REWARD_KEEP[m]) then return m end
	end
	return installed_mode()
end

-- MCM's default (szm_mcm.script)
function installed_reward_mode() return installed_mode() end

local function has_text(id)
	return game.translate_string(id) ~= id
end

-- String id, or its version for a Clear Sky actor (<id>_csky) or for the reward mode
-- (<id>_money in money_only, <id>_nogear in both hardcore modes) when there is one
local function text_id(id)
	if actor_is_csky() and has_text(id .. "_csky") then
		return id .. "_csky"
	end
	local mode = reward_mode()
	if mode == "money_only" and has_text(id .. "_money") then
		return id .. "_money"
	end
	if mode ~= "full" and has_text(id .. "_nogear") then
		return id .. "_nogear"
	end
	return id
end

local function tr(id) return game.translate_string(text_id(id)) end

-- The side chosen in Act IV: "cold", "sid", "wolf" or nil
local function ending()
	return has_alife_info("szm_end_cold") and "cold" or has_alife_info("szm_end_sid") and "sid"
		or has_alife_info("szm_end_wolf") and "wolf" or nil
end

local function stage_giver(st)
	if st.giver == "@end" then
		local e = ending()
		return e == "cold" and COLD or e == "sid" and SID or e == "wolf" and WOLF or nil
	end
	return st.giver
end

local function level_of(gvid)
	return game_graph():vertex(gvid):level_id()
end

local function actor_level()
	return level_of(db.actor:game_vertex_id())
end

-- Spawn a weapon in the actor's inventory with all parts in perfect condition;
-- worn: only the barrel, the rest at WORN_PART_MIN..WORN_PART_MAX
local function give_pristine_weapon(section, worn)
	local cond = pristine_wpn_cond()
	local se_obj = alife_create_item(section, db.actor, { cond = cond })
	if not se_obj then
		printf("[SZM] failed to create pristine %s", section)
		return
	end
	local base = ini_sys:r_string_ex(section, "parent_section") or section
	local parts = itms_manager.ini_parts:r_string_ex("con_parts_list", base)
	if parts then
		-- same layout item_parts.evaluate_parts saves: [weapon] = condition, [part] = part condition
		local data = { [base] = math.ceil(cond * 100) }
		local log = {}
		for _, part in ipairs(str_explode(parts, ",")) do
			local barrel = string.find(part, "barrel") ~= nil
			data[part] = (worn and not barrel) and math.random(WORN_PART_MIN, WORN_PART_MAX) or PRISTINE_PART_CON
			log[#log + 1] = part .. "=" .. data[part]
		end
		item_parts.set_parts_con(se_obj.id, data)
		if worn then
			printf("[SZM] worn %s: %s", section, table.concat(log, ", "))
		end
	end
	news_manager.relocate_item(db.actor, "in", section, 1)
end

local function give_ammo_boxes(sec, boxes)
	local box_size = ini_sys:r_u32(sec, "box_size")
	for i = 1, boxes do
		alife_create_item(sec, db.actor, { ammo = box_size })
	end
	news_manager.relocate_item(db.actor, "in", sec, box_size * boxes)
end

-- Full boxes of the first ammo type of each firearm in the weapon slots (like dialogs.give_suitable_ammo)
local function give_weapon_ammo(boxes)
	local ammo_secs, seen = {}, {}
	for _, slot in ipairs({2, 3}) do
		local wpn = db.actor:item_in_slot(slot)
		if wpn and IsWeapon(wpn) and not IsMelee(wpn) then
			local ammo = parse_list(ini_sys, wpn:section(), "ammo_class")
			local sec = ammo and ammo[1]
			if sec and not seen[sec] then
				seen[sec] = true
				ammo_secs[#ammo_secs + 1] = sec
			end
		end
	end
	if #ammo_secs == 0 then
		ammo_secs[1] = FALLBACK_AMMO
	end
	for _, sec in ipairs(ammo_secs) do
		give_ammo_boxes(sec, boxes)
	end
end

local function give_items(list)
	for _, it in ipairs(list or {}) do
		if it[1] == "@ammo" then
			give_weapon_ammo(it[2])
		elseif it.pristine or it.worn then
			for i = 1, it[2] do
				give_pristine_weapon(it[1], it.worn)
			end
		else
			itms_manager.relocate_item_to_actor(db.actor, nil, it[1], it[2])
		end
		if it.ammo then
			-- boxes of the first ammo type of a weapon reward
			local ammo = parse_list(ini_sys, it[1], "ammo_class")
			give_ammo_boxes(ammo and ammo[1] or FALLBACK_AMMO, it.ammo)
		end
	end
end

---------------------------< Scaled rewards >---------------------------
-- pcall with the error logged once per place (actor_on_update would repeat it every few seconds)
local errors_logged = {}
local function safe_call(where, fn, ...)
	local ok, res = pcall(fn, ...)
	if ok then return true, res end
	if not errors_logged[where] then
		errors_logged[where] = true
		printf("! [SZM] scaled rewards: %s failed, using fixed rewards: %s", where, tostring(res))
	end
	return false
end

local function item_cost(sec)
	return ini_sys:r_float_ex(sec, "cost") or 0
end

-- Outfit class (OUTFIT_CLASS), 0 for other categories
local function item_rank(cat, sec)
	if cat ~= "outfit" then return 0 end
	return OUTFIT_CLASS[ini_sys:r_string_ex(sec, "kind") or ""] or 0
end

-- GEAR_TIERS[cat] (or GEAR_OVERFLOW[cat]) that exist in this game, weakest first (cached)
local tiers_cache = {}
local function gear_tiers(cat, overflow)
	local key = (overflow and "+" or "") .. cat
	if tiers_cache[key] then return tiers_cache[key] end
	local list = {}
	for _, sec in ipairs((overflow and GEAR_OVERFLOW or GEAR_TIERS)[cat] or {}) do
		if ini_sys:section_exist(sec) then
			list[#list + 1] = sec
		else
			printf("[SZM] %s.%s: no section %s, skipped", overflow and "GEAR_OVERFLOW" or "GEAR_TIERS", cat, sec)
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = item_rank(cat, a), item_rank(cat, b)
		if ra ~= rb then return ra < rb end
		return item_cost(a) < item_cost(b)
	end)
	tiers_cache[key] = list
	return list
end

-- Clearly better than the actor's best of the category (its class and cost): a higher class, or the same
-- class and more than UPGRADE_MARGIN x the cost
local function is_upgrade(cat, sec, rank, cost)
	local r = item_rank(cat, sec)
	if r ~= rank then return r > rank end
	return item_cost(sec) > cost * UPGRADE_MARGIN
end

local function first_upgrade(cat, list, rank, cost)
	for _, sec in ipairs(list) do
		if is_upgrade(cat, sec, rank, cost) then
			return sec
		end
	end
end

local function gear_category(obj)
	if IsWeapon(obj) then
		return not IsMelee(obj) and "weapon" or nil
	elseif IsOutfit(obj) then
		return "outfit"
	elseif clsid.equ_backpack and obj:clsid() == clsid.equ_backpack then
		return "backpack"
	end
end

-- The most valuable item ever equipped, per category. Remembered in the save, so taking the gear off
-- before a report doesn't lower the rewards.
local function best_gear()
	local best = load_var(db.actor, VAR_GEAR) or { weapon = 0, outfit = 0, backpack = 0 }
	best.ranks = best.ranks or {}   -- outfit class of the best outfit (saves from 2.1.0 and older: none)
	local changed = false
	for slot = 1, 16 do
		local obj = db.actor:item_in_slot(slot)
		local cat = obj and gear_category(obj)
		if cat then
			local sec = obj:section()
			local r, cost = item_rank(cat, sec), item_cost(sec)
			local br, bc = best.ranks[cat] or 0, best[cat] or 0
			if r > br or (r == br and cost > bc) then
				best[cat], best.ranks[cat] = cost, r
				changed = true
			end
		end
	end
	if changed then
		save_var(db.actor, VAR_GEAR, best)
	end
	return best
end

local function gear_level()
	local best, lvl = best_gear(), 0
	for _, cat in ipairs({ "weapon", "outfit" }) do
		local br, bc = best.ranks[cat] or 0, best[cat] or 0
		for i, sec in ipairs(gear_tiers(cat)) do
			local r = item_rank(cat, sec)
			if br > r or (br == r and bc >= item_cost(sec)) then
				lvl = math.max(lvl, i)
			end
		end
	end
	return math.min(lvl, 3)
end

local function money_mult()
	local ok, lvl = safe_call("gear_level", gear_level)
	return ok and MONEY_MULT[lvl] or 1
end

local function round_money(x)
	return math.floor(x / 100 + 0.5) * 100
end

-- Resolves "@gear" / "@medkit": { items = rewards for give_items, cash = money instead of gear,
-- notes = what the giver has to explain, in order: "swap_<category>" (money instead), "worn_weapon" }
local function plan_rewards_scaled(list)
	local best, lvl = best_gear(), gear_level()
	local plan = { items = {}, cash = 0, notes = {} }
	for _, it in ipairs(list or {}) do
		if it[1] == "@gear" then
			local cat = it[2]
			local tiers, rank, mine = gear_tiers(cat), best.ranks[cat] or 0, best[cat] or 0
			local pick = first_upgrade(cat, tiers, rank, mine)
			local worn = not pick and first_upgrade(cat, gear_tiers(cat, true), rank, mine)
			if pick then
				plan.items[#plan.items + 1] = { pick, 1, pristine = (cat == "weapon") or nil, ammo = it.ammo }
			elseif worn then
				plan.items[#plan.items + 1] = { worn, 1, worn = true, ammo = it.ammo }
				plan.notes[#plan.notes + 1] = "worn_" .. cat
			elseif #tiers > 0 then
				plan.cash = plan.cash + round_money(item_cost(tiers[#tiers]) * CASH_SWAP_RATIO)
				plan.notes[#plan.notes + 1] = "swap_" .. cat
			end
		elseif it[1] == "@medkit" then
			local sec = MEDKITS[lvl]
			if not (sec and ini_sys:section_exist(sec)) then sec = "medkit" end
			plan.items[#plan.items + 1] = { sec, it[2] }
		else
			plan.items[#plan.items + 1] = it
		end
	end
	return plan
end

-- The rewards as before scaling: FIXED_GEAR, plain medkits, no money instead of gear
local function plan_rewards_fixed(list)
	local plan = { items = {}, cash = 0, notes = {} }
	for _, it in ipairs(list or {}) do
		if it[1] == "@gear" then
			local g = FIXED_GEAR[it[2]]
			if g then
				plan.items[#plan.items + 1] = { g[1], g[2], pristine = g.pristine, ammo = it.ammo }
			end
		elseif it[1] == "@medkit" then
			plan.items[#plan.items + 1] = { "medkit", it[2] }
		else
			plan.items[#plan.items + 1] = it
		end
	end
	return plan
end

local function reward_kind(it)
	local sec = it[1]
	if sec == "@ammo" or string.find(sec, "^ammo_") then return "ammo" end
	if sec == "@medkit" or sec == "bandage" or string.find(sec, "^medkit") then return "medical" end
	if string.find(sec, "^af_") then return "artefact" end
	return "gear"
end

-- The rewards the reward mode gives
local function mode_filter(list)
	local keep = REWARD_KEEP[reward_mode()]
	if not keep then return list end
	local out = {}
	for _, it in ipairs(list or {}) do
		if keep[reward_kind(it)] then out[#out + 1] = it end
	end
	return out
end

local function plan_rewards(list)
	list = mode_filter(list)
	local ok, plan = safe_call("plan_rewards", plan_rewards_scaled, list)
	return ok and plan or plan_rewards_fixed(list)
end

local function give_plan(plan, first_speaker, second_speaker)
	give_items(plan.items)
	if plan.cash > 0 then
		dialogs.relocate_money_to_actor(first_speaker, second_speaker, plan.cash)
		printf("[SZM] gear swapped for %s RU (%s)", plan.cash, table.concat(plan.notes, ", "))
	end
end

local function has_detector()
	for _, sec in ipairs(DETECTORS) do
		if db.actor:object(sec) then return true end
	end
	return false
end

local function get_squad(n)
	local id = load_var(db.actor, var_squad(n))
	return id and alife_object(id)
end

-- Sid is a script_trader object without alive(); like axr_task_manager.is_task_giver_valid, treat it as alive
local function story_npc_alive(story_id)
	local se_npc = get_story_se_object(story_id)
	if not se_npc then return false end
	if se_npc:clsid() == clsid.script_trader then return true end
	return se_npc.alive == nil or se_npc:alive()
end

---------------------------< The Hum >---------------------------
local snd_hum = sound_object("radio\\white_noise\\white_noise_heavy")

-- Story messages go to the PDA/radio only (no mid-screen lines)
function story_msg(msg_id)
	news_manager.send_tip(db.actor, tr(msg_id), nil, nil, 20000)
end

-- msg_id: string id of the PDA message sent with it (optional)
-- Strength of the screen effect (psi.ppe at full strength is a strong blue tint)
HUM_PP_FACTOR = 0.2

function play_hum(msg_id)
	snd_hum:play(db.actor, 0, sound_object.s2d)
	level.add_pp_effector("psi.ppe", 8614, false)
	level.set_pp_effector_factor(8614, HUM_PP_FACTOR)
	level.add_cam_effector("camera_effects\\earthquake_20.anm", 8615, false, "", 0, false)
	if msg_id then
		story_msg(msg_id)
	end
	printf("[SZM] the Hum (%s)", tostring(msg_id))
end

---------------------------< Next-offer map spot >---------------------------
local function remove_spot(id, spot)
	if id and level.map_has_object_spot(id, spot) ~= 0 then
		level.map_remove_object_spot(id, spot)
	end
end

local function clear_offer_spot()
	local id = load_var(db.actor, VAR_SPOT)
	remove_spot(id, OFFER_SPOT)
	remove_spot(id, OLD_OFFER_SPOT)
	save_var(db.actor, VAR_SPOT, nil)
end

-- Act IV: the task has three possible recipients, so instead of one task target
-- each of them gets a map spot with its own hint
local CHOICE_SPOTS = {
	{ story_id = COLD, hint = "szm_choice_hint_cold" },
	{ story_id = SID,  hint = "szm_choice_hint_sid" },
	{ story_id = WOLF, hint = "szm_choice_hint_wolf" },
}

-- A Clear Sky actor can't sell the Kamerton to Sid
local function sid_choice_allowed()
	return not actor_is_csky()
end

local function mark_choice_spots()
	for _, c in ipairs(CHOICE_SPOTS) do
		local id = get_story_object_id(c.story_id)
		remove_spot(id, OLD_OFFER_SPOT)
		if c.story_id == SID and not sid_choice_allowed() then
			remove_spot(id, OFFER_SPOT)
			id = nil
		end
		if id and level.map_has_object_spot(id, OFFER_SPOT) == 0 then
			level.map_add_object_spot_ser(id, OFFER_SPOT, tr(c.hint))
		end
	end
end

-- Act IV: each interested party calls the player on the radio, so it is clear
-- the Kamerton can go to any of them. Staggered by the news timeout (seconds).
local CHOICE_MSGS = {
	{ name = "szm_name_cold", icon = "ui_inGame2_cold", text = "szm_choice_msg_cold", delay = 3 },
	{ name = "szm_name_sid",  icon = "ui_inGame2_sid",  text = "szm_choice_msg_sid",  delay = 14 },
	{ name = "szm_name_wolf", icon = "ui_inGame2_wolf", text = "szm_choice_msg_wolf", delay = 25 },
}

-- PDA/radio message from a story character (name and text are string ids, delay in seconds)
local function radio_msg(name, text, icon, delay)
	db.actor:give_game_news(tr(name), tr(text), icon, (delay or 0) * 1000, 15000, 0)
end

local function send_choice_messages()
	for _, m in ipairs(CHOICE_MSGS) do
		if m.name ~= "szm_name_sid" or sid_choice_allowed() then
			radio_msg(m.name, m.text, m.icon, m.delay)
		end
	end
	CreateTimeEvent("szm_choice_msgs", "snd", 0, function()
		xr_sound.set_sound_play(AC_ID, "pda_tips")
		return true
	end)
	printf("[SZM] Act IV radio messages sent")
end

local function clear_choice_spots()
	for _, c in ipairs(CHOICE_SPOTS) do
		local id = get_story_object_id(c.story_id)
		remove_spot(id, OFFER_SPOT)
		remove_spot(id, OLD_OFFER_SPOT)
	end
end

-- After stage n is turned in: mark whoever offers stage n + 1
local function mark_next_offer(n)
	clear_offer_spot()
	local story_id = OFFER_AT[n + 1]
	local id = story_id and get_story_object_id(story_id)
	if not id then return end
	level.map_add_object_spot_ser(id, OFFER_SPOT, tr("szm_offer_hint"))
	save_var(db.actor, VAR_SPOT, id)
end

---------------------------< Spawn points >---------------------------
local function is_recent(name)
	for _, used in ipairs(load_var(db.actor, VAR_USED) or {}) do
		if used == name then return true end
	end
	return false
end

local function remember_smart(name)
	local list = load_var(db.actor, VAR_USED) or {}
	table.insert(list, 1, name)
	while #list > RECENT_SMARTS do table.remove(list) end
	save_var(db.actor, VAR_USED, list)
end

-- Too close to the actor for a stage with far_from_actor (only smarts on the actor's level count)
local function too_close_to_actor(n, smart)
	local keep = STAGES[n].far_from_actor
	return keep ~= nil and level_of(smart.m_game_vertex_id) == actor_level()
		and smart.position:distance_to(db.actor:position()) < keep
end

-- far_from_actor stages when every smart is too close: the one farthest from the actor
local function farthest_from_actor(smarts, exclude)
	local best, best_dist
	for _, name in ipairs(smarts) do
		local smart = name ~= exclude and SIMBOARD.smarts_by_names[name]
		if smart and level_of(smart.m_game_vertex_id) == actor_level() then
			local dist = smart.position:distance_to(db.actor:position())
			if not best_dist or dist > best_dist then
				best, best_dist = smart, dist
			end
		end
	end
	return best
end

-- Squads other than the story's own that the sim board has at (or heading to) the smart
local function smart_population(smart)
	local info = SIMBOARD.smarts[smart.id]
	if not (info and info.squads) then return 0 end
	local own = {}
	for i = 1, #STAGES do
		for _, var in ipairs({ var_squad(i), var_escort(i) }) do
			local id = load_var(db.actor, var)
			if id then own[id] = true end
		end
	end
	local cnt = 0
	for id in pairs(info.squads) do
		if not own[id] then cnt = cnt + 1 end
	end
	return cnt
end

-- Does stage n's squad hunt the actor (area tells the strike squad from the strike's bodies)
local function hunting_area(n, area)
	local st = STAGES[n]
	return (st.hunt and area == nil) or (st.strike and st.strike.hunt and area == st.strike.squad_area)
end

-- A smart in the [min_dist, max_dist] ring around origin; if none, the nearest one not closer than min_dist.
-- Preferred: nobody else at the smart, then not used by the last stages. Hunting squads take the nearest
-- of the preferred ones, the rest a random one.
local function pick_spawn_smart(n, origin, area, exclude)
	local nearest = hunting_area(n, area)
	local smarts, min_dist, max_dist = unpack(area or STAGES[n].area)
	local ring, ring_key, fallback, fallback_key, fallback_dist = {}, nil, nil, nil, math.huge
	for _, name in ipairs(smarts) do
		local smart = name ~= exclude and SIMBOARD.smarts_by_names[name]
		if smart and too_close_to_actor(n, smart) then
			smart = nil
		end
		if smart then
			local dist = smart.position:distance_to(origin)
			local key = (smart_population(smart) > 0 and 2 or 0) + (is_recent(name) and 1 or 0)
			if dist >= min_dist and dist <= max_dist then
				if not ring_key or key < ring_key then
					ring, ring_key = { smart }, key
				elseif key == ring_key then
					ring[#ring + 1] = smart
				end
			end
			if dist >= min_dist and (not fallback_key or key < fallback_key or (key == fallback_key and dist < fallback_dist)) then
				fallback, fallback_key, fallback_dist = smart, key, dist
			end
		end
	end
	local smart
	if #ring > 0 then
		if nearest then
			table.sort(ring, function(a, b) return a.position:distance_to(origin) < b.position:distance_to(origin) end)
			smart = ring[1]
		else
			smart = ring[math.random(#ring)]
		end
	else
		smart = fallback
	end
	if smart and smart_population(smart) > 0 then
		printf("[SZM] stage %s: every spawn smart has someone at it, using %s", n, smart:name())
	end
	if not smart and STAGES[n].far_from_actor then
		smart = farthest_from_actor(smarts, exclude)
	end
	if not smart then
		printf("[SZM] stage %s: no spawn smart found", n)
	end
	return smart
end

local INVALID_LVID = 4294967295

-- Positions of every anomaly on the given level, with a safe distance for each
local function collect_anomalies(level_id)
	local list = {}
	local sim, gg = alife(), game_graph()
	for id = 1, 65534 do
		local se_obj = sim:object(id)
		if se_obj then
			local cls = se_obj:clsid()
			if IsAnomaly(nil, cls) and cls ~= clsid.zone_campfire and gg:vertex(se_obj.m_game_vertex_id):level_id() == level_id then
				local rad = (cls == clsid.zone_radioactive or cls == clsid.zone_radio_s)
				list[#list + 1] = { pos = se_obj.position, dist = rad and ANOMALY_SAFE_DIST_RAD or ANOMALY_SAFE_DIST }
			end
		end
	end
	return list
end

local function is_point_safe(pos, anomalies, used, min_spacing)
	for _, a in ipairs(anomalies) do
		if pos:distance_to(a.pos) < a.dist then return false end
	end
	for _, u in ipairs(used or {}) do
		if pos:distance_to(u) < min_spacing then return false end
	end
	return true
end

-- First navigable, anomaly-free point on rings around center (actor's level only)
local function find_safe_point(center, radii, anomalies, used, min_spacing)
	for _, r in ipairs(radii) do
		local steps = r == 0 and 1 or 8
		for i = 0, steps - 1 do
			local a = i * (2 * math.pi / steps)
			local p = vector():set(center.x + r * math.cos(a), center.y, center.z + r * math.sin(a))
			local lvid = level.vertex_id(p)
			if lvid and lvid < INVALID_LVID then
				local vp = level.vertex_position(lvid)
				if vp:distance_to(p) < 3 and is_point_safe(vp, anomalies, used, min_spacing) then
					return vp, lvid
				end
			end
		end
	end
end

-- { pos, lvid, gvid, name }: an anomaly-free point near a smart of the ring. Smarts on other levels
-- fall back to the smart centre (their AI grid can't be queried).
local SMART_RADII = { 0, 4, 8, 12, 16, 20, 25, 30 }
-- forced = smart name chosen earlier (e.g. the convoy's meeting point); other smarts are a fallback only
local function pick_safe_spawn(n, origin, area, exclude, forced)
	local first = forced and SIMBOARD.smarts_by_names[forced] or pick_spawn_smart(n, origin, area, exclude)
	if not first then return end
	local lvl = actor_level()
	local center = { pos = first.position, lvid = first.m_level_vertex_id, gvid = first.m_game_vertex_id, name = first:name() }
	if level_of(first.m_game_vertex_id) ~= lvl then
		return center
	end

	local anomalies = collect_anomalies(lvl)
	local candidates = { first }
	local smarts, min_dist, max_dist = unpack(area or STAGES[n].area)
	for _, name in ipairs(smarts) do
		local smart = name ~= exclude and name ~= first:name() and not is_recent(name) and SIMBOARD.smarts_by_names[name]
		if smart and level_of(smart.m_game_vertex_id) == lvl then
			local dist = smart.position:distance_to(origin)
			if dist >= min_dist and dist <= max_dist then
				candidates[#candidates + 1] = smart
			end
		end
	end
	for _, smart in ipairs(candidates) do
		local pos, lvid = find_safe_point(smart.position, SMART_RADII, anomalies)
		if pos then
			printf("[SZM] stage %s: anomaly-free point near %s (%s anomalies)", n, smart:name(), #anomalies)
			return { pos = pos, lvid = lvid, gvid = smart.m_game_vertex_id, name = smart:name() }
		end
	end
	printf("[SZM] stage %s: no anomaly-free point, using %s centre", n, first:name())
	return center
end

---------------------------< Spawning >---------------------------
-- section/area default to STAGES[n].squad / .area; carry = item put on the commander
---------------------------< Hostility >---------------------------
local function squad_is_hostile(squad)
	return ini_sys:r_string_ex(squad:section_name(), "relationship") == "enemy"
end

-- npc id -> true once logged (not saved: only for the log)
local hostile_logged = {}

-- HOSTILE_GOODWILL towards the actor on every member: online ones that don't see the actor as an enemy,
-- and (all = true, at spawn) offline ones on the server side
local function force_hostile(squad, all)
	if not squad_is_hostile(squad) then return end
	for k in squad:squad_members() do
		local npc = db.storage[k.id] and db.storage[k.id].object
		if npc then
			if npc:alive() and npc:relation(db.actor) ~= game_object.enemy then
				npc:force_set_goodwill(HOSTILE_GOODWILL, db.actor)
				if not hostile_logged[k.id] then
					hostile_logged[k.id] = true
					printf("[SZM] %s (%s, squad %s) was not hostile to the actor: goodwill set to %s",
						npc:name(), npc:character_community(), squad:section_name(), HOSTILE_GOODWILL)
				end
			end
		elseif all and k.object then
			k.object:force_set_goodwill(HOSTILE_GOODWILL, AC_ID)
		end
	end
end

local function spawn_squad(n, origin, section, area, exclude, carry)
	section = section or STAGES[n].squad
	local smart = pick_spawn_smart(n, origin, area, exclude)
	if not smart then return end

	local squad = SIMBOARD:create_squad(smart, section)
	if not squad then
		printf("[SZM] stage %s: failed to create squad %s", n, section)
		return
	end
	force_hostile(squad, true)
	-- keep it at its smart, out of offline combat, and online at any hour (night predators otherwise
	-- stay offline 6:00-18:00); force_online is not saved, the status functor sets it again
	squad.scripted_target = smart:name()
	squad.force_online = true
	sim_offline_combat.task_squads[squad.id] = true
	save_var(db.actor, var_squad(n), squad.id)
	remember_smart(smart:name())

	if carry then
		local commander = alife_object(squad:commander_id())
		if commander then
			alife_create_item(carry, commander)
			save_var(db.actor, var_carrier(n), commander.id)
		end
	end
	printf("[SZM] stage %s: spawned %s (id %s) at %s%s", n, section, squad.id, smart:name(), carry and (" carrying " .. carry) or "")
	return squad
end

---------------------------< Transmitter (stage 24) >---------------------------
local transmitter_fx = {}   -- looping particle objects, by key (not saved)
local transmitter_status    -- last state written to the log

local function transmitter_state()
	return load_var(db.actor, VAR_TRANSMITTER)
end

local function stop_transmitter_fx()
	for k, p in pairs(transmitter_fx) do
		if p:playing() then p:stop() end
		transmitter_fx[k] = nil
	end
end

local function play_loop(key, name, pos)
	transmitter_fx[key] = transmitter_fx[key] or particles_object(name)
	if not transmitter_fx[key]:playing() then
		transmitter_fx[key]:play_at_pos(pos)
	end
end

-- sound_object has the same playing / stop as particles_object, so it lives in transmitter_fx too
-- Range and volume apply to the playing sound, so they are set after play (before it they are lost and
-- the file's own params stay)
local function play_sound_loop(key, path, obj)
	transmitter_fx[key] = transmitter_fx[key] or sound_object(path)
	local snd = transmitter_fx[key]
	if not snd:playing() then
		snd:play_at_pos(obj, obj:position(), 0, sound_object.s3d + sound_object.looped)
		snd.min_distance = TRANSMITTER_SOUND_DIST[1]
		snd.max_distance = TRANSMITTER_SOUND_DIST[2]
		snd.volume = TRANSMITTER_SOUND_VOLUME
		printf("[SZM] transmitter sound %s: started, playing = %s, %s m from the actor", path,
			tostring(snd:playing()), math.floor(obj:position():distance_to(db.actor:position())))
	end
end

local function remove_transmitter()
	stop_transmitter_fx()
	local t = transmitter_state()
	for _, id in ipairs(t and { t.prop, unpack(t.parts or {}) } or {}) do
		if alife_object(id) then
			alife_release_id(id)
		end
	end
	save_var(db.actor, VAR_TRANSMITTER, nil)
	printf("[SZM] transmitter removed")
end

-- A few metres from the squad's smart, so the guards don't spawn inside it
local function spawn_transmitter(n, squad)
	local smart = squad.scripted_target and SIMBOARD.smarts_by_names[squad.scripted_target]
	if not smart then return end
	local pos, lvid = smart.position, smart.m_level_vertex_id
	if level_of(smart.m_game_vertex_id) == actor_level() then
		local p, v = find_safe_point(smart.position, { 6, 8, 10, 12, 4 }, collect_anomalies(actor_level()))
		if p then pos, lvid = p, v end
	end
	local se = alife_create(TRANSMITTER_PROP, pos, lvid, smart.m_game_vertex_id)
	if not se then
		printf("[SZM] stage %s: failed to create %s", n, TRANSMITTER_PROP)
		return
	end
	-- the other parts around it, on the ground where the AI grid has a point close below them
	local parts = {}
	for _, part in ipairs(TRANSMITTER_PARTS) do
		local p, v = vector():set(pos.x + part[2], pos.y, pos.z + part[3]), lvid
		local pv = level_of(smart.m_game_vertex_id) == actor_level() and level.vertex_id(p)
		if pv and pv < INVALID_LVID then
			local vp = level.vertex_position(pv)
			if math.abs(vp.y - pos.y) < 1.5 then
				p, v = vector():set(p.x, vp.y, p.z), pv
			end
		end
		local se_part = alife_create(part[1], p, v, smart.m_game_vertex_id)
		if se_part then parts[#parts + 1] = se_part.id end
	end
	save_var(db.actor, VAR_TRANSMITTER, { prop = se.id, parts = parts, n = n })
	printf("[SZM] stage %s: transmitter (id %s, %s parts) near %s", n, se.id, #parts, smart:name())
end

-- Pull the module out (the guards must be dead)
local function use_transmitter(t, obj)
	if get_squad(t.n) then
		news_manager.send_tip(db.actor, tr("szm_transmitter_guarded"), nil, nil, 6000)
		return
	end
	t.taken = true
	save_var(db.actor, VAR_TRANSMITTER, t)
	stop_transmitter_fx()
	obj:set_tip_text("")
	obj:set_nonscript_usable(false)
	local sec = STAGES[t.n].transmitter
	alife_create_item(sec, db.actor)
	news_manager.relocate_item(db.actor, "in", sec, 1)
	printf("[SZM] stage %s: %s taken from the transmitter", t.n, sec)
end

-- The transmitter when the actor stands next to it with the module still in, else nil
local function transmitter_in_reach()
	local t = transmitter_state()
	if not t or t.taken then return end
	local obj = t.prop and level.object_by_id(t.prop)
	if obj and obj:position():distance_to(db.actor:position()) <= TRANSMITTER_USE_DIST then
		return t, obj
	end
end

-- Every second: effects while the module is in and the actor is near; off once it is out; gone when the
-- actor has left the level with the module
local function update_transmitter()
	local t = transmitter_state()
	if not t then return end
	if level.name() ~= TRANSMITTER_LEVEL then
		stop_transmitter_fx()
		if t.taken then remove_transmitter() end
		return
	end
	local obj = t.prop and level.object_by_id(t.prop)
	local status = not obj and "offline" or t.taken and "off (module out)" or "on"
	if status ~= transmitter_status then
		transmitter_status = status
		printf("[SZM] transmitter %s: %s", tostring(t.prop), status)
	end
	if not obj then
		stop_transmitter_fx()
		return
	end
	if t.taken then
		obj:set_tip_text("")
		obj:set_nonscript_usable(false)
		return
	end
	local dist = obj:position():distance_to(db.actor:position())
	if dist > TRANSMITTER_FX_DIST then
		stop_transmitter_fx()
		return
	end
	if dist <= TRANSMITTER_USE_DIST then
		actor_menu.set_msg(1, "szm_transmitter_hint", 2)   -- SetTextST: $$ACTION_USE$$ becomes the key
	end
	local pos = obj:position()
	for i, name in ipairs(TRANSMITTER_PARTICLES) do
		play_loop("main" .. i, name, pos)
	end
	for i, path in ipairs(TRANSMITTER_SOUNDS) do
		play_sound_loop("snd" .. i, path, obj)
	end
	for i, id in ipairs(t.parts or {}) do
		local part = level.object_by_id(id)
		if part then
			for j, name in ipairs(TRANSMITTER_PART_PARTICLES) do
				play_loop("part" .. i .. "_" .. j, name, part:position())
			end
		end
	end
	for i, off in ipairs(TRANSMITTER_FX_SPOTS) do
		for j, name in ipairs(TRANSMITTER_SPOT_PARTICLES) do
			play_loop("spot" .. i .. "_" .. j, name, vector():set(pos.x + off[1], pos.y, pos.z + off[2]))
		end
	end
end

-- Aiming at the transmitter and using it (its logic, configs\scripts\szm_transmitter.ltx, makes it usable)
local function physic_object_on_use_callback(obj, who)
	local t = transmitter_state()
	if t and t.prop == obj:id() and not t.taken then
		use_transmitter(t, obj)
	end
end

-- The use key next to the transmitter, wherever the actor looks
local function on_key_press(key)
	if dik_to_bind(key) ~= key_bindings.kUSE or not db.actor then return end
	local t, obj = transmitter_in_reach()
	if t then
		use_transmitter(t, obj)
	end
end

---------------------------< Leash >---------------------------
-- npc id -> { pos = anchor, n = stage }; not saved, rebuilt by the status functors
local leash = {}
local LEASH_SQR        = LEASH_RADIUS * LEASH_RADIUS
local SELF_DEFENSE_SQR = SELF_DEFENSE_RADIUS * SELF_DEFENSE_RADIUS

local function clear_leash(n)
	for id, l in pairs(leash) do
		if l.n == n then leash[id] = nil end
	end
end

local function set_leash(n, squad)
	local smart = squad.scripted_target and SIMBOARD.smarts_by_names[squad.scripted_target]
	if not smart then return end
	for k in squad:squad_members() do
		leash[k.id] = { pos = smart.position, n = n }
	end
end

local function on_enemy_eval(obj, enemy, flags)
	local l = leash[obj:id()]
	if not l then return end
	if enemy:id() == AC_ID or enemy:has_info("npcx_is_companion") then return end
	if enemy:position():distance_to_sqr(l.pos) > LEASH_SQR
		and enemy:position():distance_to_sqr(obj:position()) > SELF_DEFENSE_SQR then
		flags.override = true
		flags.result = false
	end
end

local function remove_squad(n)
	local squad = get_squad(n)
	if squad then
		squad:remove_squad()
	end
	clear_leash(n)
	save_var(db.actor, var_squad(n), nil)
end

-- Same approach as xr_effects.spawn_corpse: create the NPC, then kill it on the server side.
-- Quest items keep the body from release_body_manager and from NPC looters.
local function spawn_corpse(n, origin)
	local spot = pick_safe_spawn(n, origin)
	if not spot then return end
	local se_npc = alife_create(STAGES[n].corpse, spot.pos, spot.lvid, spot.gvid)
	if not se_npc then return end
	alife_create_item(STAGES[n].fetch[1], se_npc)
	se_npc:kill()
	save_var(db.actor, var_corpse(n), se_npc.id)
	remember_smart(spot.name)
	printf("[SZM] stage %s: corpse %s (id %s) near %s", n, STAGES[n].corpse, se_npc.id, spot.name)
	return se_npc
end

local function spawn_medusa(section)
	local p = MEDUSA_SPAWN
	local se_obj = alife_create(section or "af_medusa", vector():set(p.pos[1], p.pos[2], p.pos[3]), p.lvid, p.gvid)
	if se_obj then
		save_var(db.actor, VAR_MEDUSA, se_obj.id)
	end
end

---------------------------< Escort companions >---------------------------
local function get_escort(n)
	local id = load_var(db.actor, var_escort(n))
	local squad = id and alife_object(id)
	return squad and squad:clsid() == clsid.online_offline_group_s and squad or nil
end

-- Like xr_effects.setup_companion_task: task companions follow the actor, can't be dismissed
-- and don't count towards the companion limit
local function spawn_escort(n)
	local cfg = STAGES[n].escort
	local smart = SIMBOARD.smarts_by_names[cfg.smart]
	if not smart then
		printf("[SZM] stage %s: escort smart %s not found", n, cfg.smart)
		return
	end
	local squad = alife_create(cfg.squad, smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id)
	if not squad then
		printf("[SZM] stage %s: failed to create escort %s", n, cfg.squad)
		return
	end
	squad:create_npc(smart)
	squad:set_squad_relation()
	axr_companions.companion_squads[squad.id] = squad
	for k in squad:squad_members() do
		local se_obj = k.object or alife_object(k.id)
		if se_obj then
			se_save_var(se_obj.id, se_obj:name(), "companion", true)
			se_save_var(se_obj.id, se_obj:name(), "companion_cannot_dismiss", true)
			SIMBOARD:setup_squad_and_group(se_obj)
		end
	end
	sim_offline_combat.task_squads[squad.id] = true
	save_var(db.actor, var_escort(n), squad.id)
	give_info(escort_info(n))
	printf("[SZM] stage %s: escort %s (id %s) at %s", n, cfg.squad, squad.id, cfg.smart)
end

-- Called from the status functor: rank floor once they are online
local function update_escort(n)
	local squad = get_escort(n)
	if not squad then return end
	for k in squad:squad_members() do
		local npc = db.storage[k.id] and db.storage[k.id].object
		if npc and npc:alive() and npc:character_rank() < ESCORT_MIN_RANK then
			npc:set_character_rank(ESCORT_MIN_RANK + math.random(0, ESCORT_RANK_SPREAD))
		end
	end
end

-- On turn-in or fail: no longer companions, they go back to their base
local function dismiss_escort(n)
	local squad = get_escort(n)
	if squad then
		if axr_companions.companion_squads[squad.id] then
			axr_companions.dismiss_special_squad(squad)
		end
		-- members that were offline (dismiss_special_squad only handles online ones)
		for k in squad:squad_members() do
			local se_obj = k.object or alife_object(k.id)
			if se_obj then
				se_save_var(se_obj.id, se_obj:name(), "companion", nil)
				se_save_var(se_obj.id, se_obj:name(), "companion_cannot_dismiss", nil)
			end
		end
		axr_companions.companion_squads[squad.id] = nil
		sim_offline_combat.task_squads[squad.id] = nil
		squad.scripted_target = STAGES[n].escort.smart
		printf("[SZM] stage %s: escort %s dismissed", n, squad.id)
	end
	save_var(db.actor, var_escort(n), nil)
end

---------------------------< Multi-phase "strike" stages >---------------------------
-- phase "pending": the meeting point is on another level; bodies spawn when the actor gets there
-- phase "goto"   : bodies at the meeting point; marker on the body with the reveal item
-- phase "fight"  : the reveal item was picked up; the squad spawned near the meeting point
-- then           : objective done when the squad is dead and the fetch item is carried

local function get_strike(n) return load_var(db.actor, var_strike(n)) end

local function strike_reveal(n)
	return STAGES[n].strike.reveal or STAGES[n].fetch[1]
end

local function strike_area_level(n)
	local smarts = STAGES[n].strike.corpse_area[1]
	local smart = SIMBOARD.smarts_by_names[smarts[1]]
	return smart and level_of(smart.m_game_vertex_id)
end

local function spawn_strike_bodies(n, origin, forced)
	local cfg = STAGES[n].strike
	local spot = pick_safe_spawn(n, origin, cfg.corpse_area, nil, forced)
	if not spot then return end

	local anomalies = level_of(spot.gvid) == actor_level() and collect_anomalies(level_of(spot.gvid)) or nil
	local used = { spot.pos }
	local reveal_corpse
	for i, section in ipairs(cfg.corpses) do
		local pos, lvid = spot.pos, spot.lvid
		if i > 1 and anomalies then
			local p, l = find_safe_point(spot.pos, { 2, 3, 4, 5, 6 }, anomalies, used, 1.8)
			if p then
				pos, lvid = p, l
				used[#used + 1] = p
			end
		end
		local se_npc = alife_create(section, pos, lvid, spot.gvid)
		if se_npc then
			if i == 1 then
				alife_create_item(strike_reveal(n), se_npc)
				reveal_corpse = se_npc.id
			end
			se_npc:kill()
		end
	end
	if not reveal_corpse then return end

	-- an optional prop (the helicopter wreck) a bit away from the bodies, so they don't end up inside it
	local prop_id
	if cfg.prop then
		local pos, lvid = spot.pos, spot.lvid
		if anomalies then
			local p, l = find_safe_point(spot.pos, { 14, 16, 18, 12, 20 }, anomalies, used, 10)
			if p then pos, lvid = p, l end
		end
		local se_prop = alife_create(cfg.prop, pos, lvid, spot.gvid)
		prop_id = se_prop and se_prop.id
		printf("[SZM] stage %s: prop %s (id %s)", n, cfg.prop, tostring(prop_id))
	end

	save_var(db.actor, var_strike(n), { phase = "goto", meet = spot.name, reveal_corpse = reveal_corpse, prop = prop_id })
	remember_smart(spot.name)
	printf("[SZM] stage %s: bodies near %s, %s on %s", n, spot.name, strike_reveal(n), reveal_corpse)
	return true
end

local function start_strike(n, origin)
	if strike_area_level(n) ~= actor_level() then
		-- pick the meeting point now (it carries the task marker), spawn the bodies there on arrival
		local smart = pick_spawn_smart(n, origin, STAGES[n].strike.corpse_area)
		if not smart then return end
		save_var(db.actor, var_strike(n), { phase = "pending", meet = smart:name() })
		remember_smart(smart:name())
		printf("[SZM] stage %s: meeting point %s, bodies spawn when the actor reaches the level", n, smart:name())
		return true
	end
	return spawn_strike_bodies(n, origin)
end

-- Called from the status functor
local function update_strike(n)
	local state = get_strike(n)
	if not state then return end

	if state.phase == "pending" and strike_area_level(n) == actor_level() then
		local meet = state.meet and SIMBOARD.smarts_by_names[state.meet]
		spawn_strike_bodies(n, meet and meet.position or db.actor:position(), state.meet)
		return
	end

	if state.phase == "goto" and count_items(strike_reveal(n)) > 0 then
		local cfg = STAGES[n].strike
		local meet = SIMBOARD.smarts_by_names[state.meet]
		local origin = meet and meet.position or db.actor:position()
		local squad = spawn_squad(n, origin, cfg.squad, cfg.squad_area, state.meet, cfg.squad_carry)
		if squad then
			if cfg.hunt then
				squad.scripted_target = "actor"   -- sim_squad_scripted: target id 0, the actor (saved)
			end
			state.phase = "fight"
			save_var(db.actor, var_strike(n), state)
			story_msg("szm_task_" .. n .. "_reveal_news")
		end
	end
end

---------------------------< Stage start / finish >---------------------------
local function give_stage_task(n, giver_id)
	task_manager.get_task_manager():give_task(STAGES[n].task, giver_id)
end

-- origin: where distances of the spawn areas are measured from (the task giver)
local function start_stage_at(n, origin, giver_id)
	local st = STAGES[n]

	if st.squad then
		local squad = spawn_squad(n, origin, nil, nil, nil, st.carry)
		if not squad then return end
		if st.transmitter then spawn_transmitter(n, squad) end
		if n == BOAR_STAGE then
			local ids = {}
			for k in squad:squad_members() do
				ids[#ids + 1] = k.id
			end
			save_var(db.actor, VAR_BOARS, ids)
		end
	end
	if st.corpse and not spawn_corpse(n, origin) then return end
	if st.strike and not start_strike(n, origin) then return end
	if st.escort then spawn_escort(n) end
	if st.medusa then
		spawn_medusa(type(st.medusa) == "string" and st.medusa or nil)
		if not has_detector() then
			give_items({ {"detector_simple", 1} })
		end
	end

	-- gifts (advance = true) only in the "full" reward mode; what the stage needs always
	local items = {}
	for _, it in ipairs(st.start_items or {}) do
		if not it.advance or reward_mode() == "full" then items[#items + 1] = it end
	end
	give_items(items)
	give_stage_task(n, giver_id)
	clear_offer_spot()
	return true
end

local function start_stage(n, first_speaker, second_speaker)
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	return start_stage_at(n, npc:position(), npc:id())
end

---------------------------< Act V: radio stages >---------------------------
local function schedule_stage(n, first)
	local delay = not first and 60 * level.get_time_factor()
		or ACT5_TEST_DELAY and ACT5_TEST_DELAY * level.get_time_factor()
		or ACT5_FIRST_DELAY_H * 3600
	save_var(db.actor, VAR_NEXT, { n = n, t = utils_data.CTime_to_table(game.get_game_time()), delay = delay })
	printf("[SZM] stage %s scheduled in %s game seconds", n, math.floor(delay))
end

local function next_of(st)
	if type(st.next) == "table" then
		local e = ending()
		return e and st.next[e]
	end
	return st.next
end

local function called_info(n) return "szm_called_" .. n end

local function mark_offer_spot(story_id)
	clear_offer_spot()
	local id = story_id and get_story_object_id(story_id)
	if not id then return end
	level.map_add_object_spot_ser(id, OFFER_SPOT, tr("szm_offer_hint"))
	save_var(db.actor, VAR_SPOT, id)
end

-- Offer stages: the giver calls and asks the actor to come over (gold map spot on the giver);
-- the stage itself is handed out in the giver's offer dialog. false = try again later
local function call_for_offer(n)
	local st = STAGES[n]
	local giver = stage_giver(st)
	if not (giver and get_story_se_object(giver) and story_npc_alive(giver)) then
		printf("[SZM] stage %s: giver %s not available", n, tostring(giver))
		return false
	end
	if st.intro_hum then
		play_hum(st.intro_hum)
	end
	local r = GIVER_RADIO[giver]
	radio_msg(r.name, "szm_task_" .. n .. "_call", r.icon, st.intro_hum and 6 or 0)
	xr_sound.set_sound_play(AC_ID, "pda_tips")
	give_info(called_info(n))
	give_info(INFO_ACT5)
	mark_offer_spot(giver)
	printf("[SZM] stage %s: %s called the actor", n, giver)
	return true
end

-- The giver calls on the radio and the task starts; false = try again later
local function start_radio_stage(n)
	local st = STAGES[n]
	local giver = stage_giver(st)
	local se_giver = giver and get_story_se_object(giver)
	if not (se_giver and story_npc_alive(giver)) then
		printf("[SZM] stage %s: giver %s not available", n, tostring(giver))
		return false
	end
	if not start_stage_at(n, se_giver.position, se_giver.id) then
		printf("[SZM] stage %s: could not start, retrying", n)
		return false
	end
	if st.intro_hum then
		play_hum(st.intro_hum)
	end
	local r = GIVER_RADIO[giver]
	radio_msg(r.name, "szm_task_" .. n .. "_radio", r.icon, st.intro_hum and 6 or 0)
	xr_sound.set_sound_play(AC_ID, "pda_tips")
	give_info(INFO_ACT5)
	return true
end

local function any_story_task()
	for i = 1, #STAGES do
		if get_task(i) then return true end
	end
	return false
end

-- Checked every few seconds from actor_on_update
local function check_next_stage()
	local v = load_var(db.actor, VAR_NEXT)
	if not v then
		-- saves made after the Act IV choice, before Act V existed
		local e = ending()
		if e and not has_alife_info(INFO_ACT5) and not any_story_task() then
			schedule_stage(ACT5_FIRST[e], true)
		end
		return
	end
	if game.get_game_time():diffSec(utils_data.CTime_from_table(v.t)) < v.delay then return end
	if any_story_task() then return end
	local ok
	if STAGES[v.n].offer then
		ok = call_for_offer(v.n)
	else
		ok = start_radio_stage(v.n)
	end
	if ok then
		save_var(db.actor, VAR_NEXT, nil)
	else
		v.t = utils_data.CTime_to_table(game.get_game_time())   -- try again a bit later
		v.delay = 60 * level.get_time_factor()
		save_var(db.actor, VAR_NEXT, v)
	end
end

local END_ICONS = { cold = "ui_inGame2_cold", sid = "ui_inGame2_sid", wolf = "ui_inGame2_wolf" }

-- After a stage of Act V is done: schedule the next one, or the end of the storyline
local function act5_after(n)
	local st = STAGES[n]
	local nxt = st.next and next_of(st)
	if nxt and STAGES[nxt].offer then
		-- offered right away: in the same report dialog, or later from the giver (gold map spot)
		give_info(called_info(nxt))
		mark_offer_spot(stage_giver(STAGES[nxt]))
	elseif nxt then
		-- no dialog (the actor is still in Agroprom's tunnels): over the radio, as soon as this task is closed
		CreateTimeEvent("szm_act5_next", tostring(nxt), 2, function()
			if not get_task(nxt) and not start_radio_stage(nxt) then
				schedule_stage(nxt)   -- retried by check_next_stage
			end
			return true
		end)
	end
	if st.final then
		CreateTimeEvent("szm_final", tostring(n), 3, function()
			db.actor:give_game_news(tr("szm_final_end_title"), tr("szm_final_end_" .. st.final), END_ICONS[st.final], 0, 25000, 0)
			xr_sound.set_sound_play(AC_ID, "pda_tips")
			return true
		end)
		-- quest items of Act V that stay with the actor
		for _, sec in ipairs({ "szm_echo" }) do
			if count_items(sec) > 0 then
				itms_manager.relocate_item_from_actor(db.actor, nil, sec, 1)
			end
		end
		printf("[SZM] storyline finished (%s)", st.final)
	end
end

-- The task manager completes a task on its next update, not at once: remember the turn-in
-- so the report dialog doesn't come back in the meantime (the next offer follows in the same dialog)
local turned_in = {}

-- Reward plans made by the report dialog's preconditions (key: stage, or the Act IV choice), so what
-- the NPC says ("you've got better gear, take the money") matches what the action gives
local plans = {}
local CHOICE_BY_GIVER = { [COLD] = "cold", [SID] = "sid", [WOLF] = "wolf" }

local function current_plan(first_speaker, second_speaker)
	for n = 1, #STAGES do
		if get_task(n) then   -- one story task at a time: the one being reported
			local key, rewards = n, STAGES[n].rewards
			if STAGES[n].choice then
				local npc = dialogs.who_is_npc(first_speaker, second_speaker)
				key = npc and CHOICE_BY_GIVER[get_object_story_id(npc:id())]
				if not key then return end
				rewards = CHOICES[key].rewards
			end
			plans[key] = plan_rewards(rewards)
			return plans[key]
		end
	end
end

local function take_plan(key, rewards)
	local plan = plans[key] or plan_rewards(rewards)
	plans[key] = nil
	return plan
end

local function reward_note(first_speaker, second_speaker)
	-- on an error: no note, the NPC says the plain reward line
	local ok, plan = safe_call("current_plan", current_plan, first_speaker, second_speaker)
	return ok and plan and plan.notes[1] or nil
end

local function turn_in_stage(n, first_speaker, second_speaker)
	local st = STAGES[n]
	turned_in[n] = true
	if st.fetch and not st.keep_fetch then
		local npc = dialogs.who_is_npc(first_speaker, second_speaker)
		itms_manager.relocate_item_from_actor(db.actor, npc, st.fetch[1], st.fetch[2])
	end
	give_plan(take_plan(n, st.rewards), first_speaker, second_speaker)
	task_manager.get_task_manager():set_task_completed(st.task)
	mark_next_offer(n)
	act5_after(n)
end

local function can_offer(n)
	if has_alife_info(done_info(n)) then return false end
	if n > 1 and not has_alife_info(done_info(n - 1)) then return false end
	for i = 1, #STAGES do
		if get_task(i) then return false end   -- one story task at a time
	end
	return true
end

-- Objective done: squad dead, items carried; talk_to stages are completed only by their dialog
local function objective_done(n)
	local st = STAGES[n]
	if st.talk_to then return false end
	if st.strike then
		local state = get_strike(n)
		return state ~= nil and state.phase == "fight" and get_squad(n) == nil and has_fetch(n)
	end
	local killed  = st.squad == nil or get_squad(n) == nil
	local fetched = st.fetch == nil or has_fetch(n)
	return killed and fetched
end

local function can_turn_in(n)
	local st = STAGES[n]
	local tsk = get_task(n)
	if tsk == nil or turned_in[n] then return false end
	if st.talk_to or st.choice then
		return st.fetch == nil or has_fetch(n)
	end
	return tsk.stage == 1 and objective_done(n)
end

