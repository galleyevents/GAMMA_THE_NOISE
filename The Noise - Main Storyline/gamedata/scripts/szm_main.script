}
-- Agroprom underground (l03u_agr_underground); agr_u_bandits has residents and is left out
-- All of them have residents (soldiers, controllers, poltergeists, bloodsuckers): pick_spawn_smart prefers
-- the ones nobody is at right now.
AGR_U_SMARTS = { "agr_u_soldiers", "agr_u_monsters", "agr_u_bloodsucker", "agr_u_bloodsucker_2" }
ANYWHERE = 1000000   -- max distance meaning "any smart of the list" (giver on another level)

---------------------------< NPCs >---------------------------
-- story_ids. Sid's story_id is "esc_m_trader" (a script_trader object, like axr_task_manager uses);
-- "esc_2_12_stalker_trader" is only his character profile, used by DXML in modxml_szm.script
SID   = "esc_m_trader"
WOLF  = "esc_2_12_stalker_wolf"
SPORE = "mar_base_owl_stalker_trader"
COLD  = "mar_smart_terrain_base_stalker_leader_marsh"

---------------------------< Stages >---------------------------
-- squad        = squad section spawned for the task (must be killed); carry = item put on its commander
-- corpse       = NPC section spawned dead, carrying the fetch item
-- strike       = multi-phase: dead team at a meeting point -> picking up the fetch item spawns a squad
--                (strike.hunt = true: that squad goes after the actor instead of holding its smart)
-- hunt         = true: the stage's squad goes after the actor instead of holding its smart
-- transmitter  = item section: a transmitter (TRANSMITTER_PROP) near the squad's smart, with anomaly effects;
--                the squad guards it. Once they are dead, using it gives that item (its module) and turns
--                it off. It is removed when the actor leaves the level with the item, or the stage fails.
--                Squads and bodies go preferably to smarts nobody else is at; hunting squads to the nearest one.
-- escort       = { squad, smart }: task companions spawned at the smart, they follow the actor until the turn-in
-- fetch        = { section, amount } to bring back
-- talk_to      = story_id of the NPC who completes the stage from a dialog (no objective of its own)
-- turn_in_to   = story_id the actor reports to, if not the task giver
-- area         = { smarts, min_dist, max_dist }: ring around the task giver
-- far_from_actor = squads of the stage spawn at least this far (m) from the actor when on the actor's
--                level; if no smart qualifies, the one farthest from the actor
-- start_items / rewards = { {section, amount}, ... }
--   { section, amount, pristine = true } : weapon with every part at PRISTINE_PART_CON
--   { "@ammo", boxes }                   : boxes of ammo for the weapons in the actor's slots
--   { "@gear", category, ammo = boxes }  : the first item of GEAR_TIERS[category] clearly better than the
--                                          actor's own; none -> a worn one from GEAR_OVERFLOW (weapons), else
--                                          money instead (either way with a line in the report dialog)
--   { "@medkit", amount }                : medkits of the actor's gear level (MEDKITS)
--   advance = true (start_items)         : a gift, not needed for the stage: only in the "full" reward mode
--   REWARD_KEEP decides which rewards each reward mode gives
-- auto_next    = the task completes on its own when the objective is done and gives this stage
-- medusa       = true (Jellyfish) or an item section spawned at MEDUSA_SPAWN, the anomaly field
-- Act V (radio stages, no offer dialog):
--   giver      = story_id of who calls the actor and takes the report ("@end": the side chosen in Act IV)
--   offer      = handed out by the giver in a dialog (the first stage after a radio call asking the actor over)
--   next       = the stage that follows (offered at once, or started at once over the radio), or { cold = n, ... }
--   auto_complete = no report dialog: the task completes when the objective is done
--   intro_hum  = the Noise (with this PDA message) when the stage starts
--   final      = the end of the storyline
-- Money and goodwill come from on_complete in tm_szm.ltx (szm_reward_money scales it by MONEY_MULT).
STAGES = {
	-- ===== Prologue =====
	[1] = {  -- Sid calls the new stalker on the radio, talk to him (given automatically)
		task    = "szm_task_1",
		talk_to = SID,
