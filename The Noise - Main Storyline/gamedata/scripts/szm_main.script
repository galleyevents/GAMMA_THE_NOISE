		fetch   = { "af_medusa", 1 },
		medusa  = true,
		hum_on_fetch = "szm_hum_medusa",
		rewards = { {"@gear", "backpack"}, {"@medkit", 3}, {"bandage", 5} },
	},
	[6] = {  -- take the cylinder to Spore
		task    = "szm_task_6",
		talk_to = SPORE,
