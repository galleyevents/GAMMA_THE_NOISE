-- Act IV: Kamerton to Cold / Sid / Wolf
local function choose(key, first_speaker, second_speaker)
	local c = CHOICES[key]
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	itms_manager.relocate_item_from_actor(db.actor, npc, "szm_kamerton", 1)
	give_plan(take_plan(key, c.rewards), first_speaker, second_speaker)
	local money = c.money or (reward_mode() ~= "full" and c.hardcore_money)
	if money then
		dialogs.relocate_money_to_actor(first_speaker, second_speaker, round_money(money * money_mult()))
	end
	for _, g in ipairs(c.goodwill or {}) do
		xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, { g[1], g[2] })
	end
	give_info(c.info)
	clear_choice_spots()
	save_var(db.actor, VAR_END_TIME, utils_data.CTime_to_table(game.get_game_time()))
	task_manager.get_task_manager():set_task_completed(STAGES[16].task)
	schedule_stage(ACT5_FIRST[key], true)
	-- after the dialog window closes, so it isn't hidden behind it
	CreateTimeEvent("szm_ending", key, 3, function()
		db.actor:give_game_news(tr("szm_story_end_title"), tr("szm_story_end_" .. key), END_ICONS[key], 0, 25000, 0)
		xr_sound.set_sound_play(AC_ID, "pda_tips")
		return true
	end)
	printf("[SZM] ending: %s", key)
end
function can_turn_in_16_sid() return can_turn_in(16) and sid_choice_allowed() end
function turn_in_16_cold(a, b) choose("cold", a, b) end
function turn_in_16_sid(a, b)  choose("sid",  a, b) end
function turn_in_16_wolf(a, b) choose("wolf", a, b) end

-- Report dialogs: the NPC's reward line, or first a line about the gear reward: money instead
-- (szm_swap_<who>_<category>) or a better but worn gun (szm_worn_<who>_weapon). The preconditions
-- are exclusive, the first note of the plan wins.
function reward_not_swapped(a, b)   return reward_note(a, b) == nil end
function reward_swap_weapon(a, b)   return reward_note(a, b) == "swap_weapon" end
function reward_swap_outfit(a, b)   return reward_note(a, b) == "swap_outfit" end
function reward_swap_backpack(a, b) return reward_note(a, b) == "swap_backpack" end
function reward_worn_weapon(a, b)   return reward_note(a, b) == "worn_weapon" end

-- Phrases with a "_csky" text (szm_gen_dialogs.py): the Clear Sky actor's version or the usual one
function actor_csky()     return actor_is_csky() end
function actor_not_csky() return not actor_is_csky() end

-- Phrases with "_nogear" / "_money" texts: which one the reward mode says
function mode_full()      return reward_mode() == "full" end
function mode_hardcore()  return reward_mode() ~= "full" end
function mode_no_gear()   return reward_mode() == "no_gear" end
function mode_money()     return reward_mode() == "money_only" end
function mode_not_money() return reward_mode() ~= "money_only" end

---------------------------< Task functors >---------------------------
-- Marker for a squad stage: the body holding the item once its carrier is dead and the item
-- hasn't been picked up yet (also the boars, until the legs are cut); otherwise the squad member
-- nearest to the actor, so a member that wandered off isn't left without a marker
local function nearest_member(squad)
	local actor_pos = db.actor:position()
	local best, best_dist
	for k in squad:squad_members() do
		local se_obj = k.object or alife_object(k.id)
		if se_obj then
			local dist = se_obj.position:distance_to_sqr(actor_pos)
			if not best_dist or dist < best_dist then
				best, best_dist = k.id, dist
			end
		end
	end
	return best or squad:commander_id()
end

local function squad_target(n)
	if STAGES[n].fetch and not has_fetch(n) then
		local cid = load_var(db.actor, var_carrier(n))
		local se_c = cid and alife_object(cid)
		if se_c and se_c.alive and not se_c:alive() then
			return cid
		end
		if n == BOAR_STAGE and not get_squad(n) then
			for _, id in ipairs(load_var(db.actor, VAR_BOARS) or {}) do
				if alife_object(id) then return id end
			end
		end
	end
	local squad = get_squad(n)
	return squad and nearest_member(squad)
end

-- Stage 0 marker; stage 1 points at turn_in_to or the task giver
local function objective_target(n)
	local st = STAGES[n]
	if st.strike then
		local state = get_strike(n)
		if not state then return end
		if state.phase == "pending" then
			-- the meeting point is chosen up front, so the marker shows on the global map
			local smart = state.meet and SIMBOARD.smarts_by_names[state.meet]
			return smart and smart.id
		end
		if state.phase == "goto" then return state.reveal_corpse end
		return squad_target(n)
	elseif st.squad then
		local t = st.transmitter and not has_fetch(n) and transmitter_state()
		if t and t.prop and alife_object(t.prop) then
			return t.prop
		end
		return squad_target(n)
	elseif st.corpse then
		return load_var(db.actor, var_corpse(n))
	elseif st.medusa then
		local id = load_var(db.actor, VAR_MEDUSA)
		local se_obj = id and alife_object(id)
		return se_obj and se_obj.parent_id == 65535 and id or nil
	elseif st.talk_to then
		return get_story_object_id(st.talk_to)
	elseif st.turn_in_to and has_fetch(n) then
		return get_story_object_id(st.turn_in_to)
	end
end

for n = 1, #STAGES do
	task_functor["szm_target_" .. n] = function(task_id, field, p, tsk)
		if field ~= "target" or not tsk then return end
		if tsk.stage == 0 then
			return objective_target(n)
		end
		local to = STAGES[n].turn_in_to
		return to and get_story_object_id(to) or tsk.task_giver_id
	end

	-- PDA description per phase (string ids from st_szm.xml, the Clear Sky actor's version if there is one)
	task_functor["szm_descr_" .. n] = function(task_id, field, p, tsk)
		if tsk and tsk.stage == 1 then
			return text_id("szm_task_" .. n .. "_descr_return")
		end
		local state = STAGES[n].strike and get_strike(n)
		if state and state.phase == "fight" then
			return text_id("szm_task_" .. n .. "_descr_fight")
		end
		return text_id("szm_task_" .. n .. "_descr")
	end

	-- Called every few seconds by the task manager
	task_status_functor["szm_status_" .. n] = function(tsk, task_id)
		local st = STAGES[n]
		if st.talk_to then
			if not story_npc_alive(st.talk_to) then return "fail" end
		elseif not st.choice and not axr_task_manager.is_task_giver_valid(tsk) then
			return "fail"
		end

		if st.strike then
			update_strike(n)
		end
		if st.escort then
			-- saves already in this stage before the escort existed get it too
			if not has_alife_info(escort_info(n)) then
				spawn_escort(n)
			end
			update_escort(n)
		end
		if st.squad or st.strike then
			local squad = get_squad(n)
			if squad then
				if st.hunt or (st.strike and st.strike.hunt) then
					squad.scripted_target = "actor"   -- also squads spawned before hunt existed
					clear_leash(n)                    -- set_leash keeps no smart for them from now on
				end
				squad.force_online = true
				sim_offline_combat.task_squads[squad.id] = true
				set_leash(n, squad)
				force_hostile(squad)
			end
		end
		if st.hum_on_fetch and not has_alife_info("szm_hum_heard_" .. n) and has_fetch(n) then
			give_info("szm_hum_heard_" .. n)
			play_hum(st.hum_on_fetch)
		end

		if st.choice then
			mark_choice_spots()   -- idempotent; also restores the spots in saves made before they existed
			if not has_alife_info(INFO_CHOICE_MSGS) then   -- once; also covers saves already in stage 16
				give_info(INFO_CHOICE_MSGS)
				send_choice_messages()
			end
			return
		end
		if st.talk_to then return end
		tsk.stage = objective_done(n) and 1 or 0

		if st.auto_complete and tsk.stage == 1 then
			-- no report dialog: complete now, the next stage comes over the radio later
			if not turned_in[n] then
				turned_in[n] = true
				act5_after(n)
			end
			return "complete"
		end

		if st.auto_next and tsk.stage == 1 then
			-- no turn-in dialog: complete now, the next stage starts right away
			CreateTimeEvent("szm_auto_next", tostring(n), 1, function()
				if not get_task(st.auto_next) then
					give_stage_task(st.auto_next, tsk.task_giver_id)
				end
				return true
			end)
			return "complete"
		end
	end
end

---------------------------< Effects >---------------------------
-- on_complete / on_fail of the task sections
xr_effects.szm_cleanup = function(actor, npc, p)
	local n = tonumber(p and p[1])
	local st = n and STAGES[n]
	if not st then return end
	if st.squad or st.strike then
		remove_squad(n)
		save_var(db.actor, var_carrier(n), nil)
	end
	if st.strike then
		local state = get_strike(n)
		if state and state.prop and alife_object(state.prop) then
			alife_release_id(state.prop)   -- the helicopter wreck disappears when the stage is turned in
		end
		save_var(db.actor, var_strike(n), nil)
		-- a separate reveal item (the officer's PDA) is a quest item: take it away when done
		if st.strike.reveal and count_items(st.strike.reveal) > 0 then
			itms_manager.relocate_item_from_actor(db.actor, nil, st.strike.reveal, 1)
		end
	end
	if st.escort then dismiss_escort(n) end
	if st.corpse then save_var(db.actor, var_corpse(n), nil) end
	if n == BOAR_STAGE then save_var(db.actor, VAR_BOARS, nil) end
	if st.medusa then save_var(db.actor, VAR_MEDUSA, nil) end
	if st.transmitter then
		local t = transmitter_state()
		if t and not t.taken then remove_transmitter() end
	end
end

-- =szm_reward_money(min:max): reward_random_money scaled by the actor's gear level
xr_effects.szm_reward_money = function(actor, npc, p)
	local mn = tonumber(p and p[1]) or 0
	local mx = tonumber(p and p[2]) or mn
	local m = money_mult()
	xr_effects.reward_random_money(actor, npc, { round_money(mn * m), round_money(mx * m) })
end

---------------------------< Prologue / epilogue >---------------------------
-- Checked every few seconds (not only on load), so the prologue also starts after arriving in Cordon.
-- The info is given when the task actually starts, so a save during the delay doesn't lose it.
local prologue_scheduled = false
local prologue_last_reason
local function prologue_wait(reason)
	if reason ~= prologue_last_reason then
		prologue_last_reason = reason
		printf("[SZM] prologue waiting: %s", reason)
	end
end

local function try_prologue()
	if prologue_scheduled or has_alife_info(INFO_STARTED) then return end
	local comm = character_community(db.actor)
	if not ALLOWED_COMMUNITIES[comm] then return prologue_wait("actor community is " .. tostring(comm) .. ", not in ALLOWED_COMMUNITIES") end
	if level.name() ~= "l01_escape" then return prologue_wait("actor is on " .. level.name() .. ", needs l01_escape") end
	local sid = get_story_se_object(SID)
	if not sid then return prologue_wait("Sidorovich not found") end

	prologue_scheduled = true
	CreateTimeEvent("szm_prologue", "start", PROLOGUE_DELAY, function()
		if level.name() ~= "l01_escape" then
			-- left Cordon during the delay: wait for the next arrival
			prologue_scheduled = false
			return true
		end
		if not has_alife_info(INFO_STARTED) then
			give_info(INFO_STARTED)
			radio_msg("szm_name_sid", "szm_prologue_msg", "ui_inGame2_sid")
			xr_sound.set_sound_play(AC_ID, "pda_tips")
			give_stage_task(1, sid.id)
		end
		return true
	end)
	printf("[SZM] prologue scheduled")
end

---------------------------< Callbacks >---------------------------
-- Guarantee boar legs from the stage 2 boars (base GAMMA drop: 4 rolls at 18%)
local function monster_on_loot_init(victim, loot_table)
	if not (victim and loot_table) then return end
	local ids = load_var(db.actor, VAR_BOARS)
	if not ids then return end
	local victim_id = victim:id()
	for _, id in ipairs(ids) do
		if id == victim_id then
			local sec = "mutant_part_boar_leg"
			loot_table[sec] = loot_table[sec] or {}
			loot_table[sec].count = math.max(loot_table[sec].count or 0, BOAR_LEGS_PER_BOAR)
			return
		end
	end
end

local tg_epilogue, tg_transmitter = 0, 0
local function actor_on_update()
	local tg = time_global()
	if tg >= tg_transmitter then
		tg_transmitter = tg + 1000
		update_transmitter()
	end
	if tg < tg_epilogue then return end
	tg_epilogue = tg + 5000
	try_prologue()
	check_next_stage()
	safe_call("best_gear", best_gear)   -- remember the best gear as it is equipped, not only at the reports
end

local function actor_on_first_update()
	-- replace Fanatic's "Training Day": its start dialog is hidden once this info is set
	if not has_alife_info("fanat_training_start_done") then
		give_info("fanat_training_start_done")
	end
	try_prologue()
	-- saves from before the gold offer spot: swap the old silver one
	local id = load_var(db.actor, VAR_SPOT)
	if id and level.map_has_object_spot(id, OLD_OFFER_SPOT) ~= 0 then
		level.map_remove_object_spot(id, OLD_OFFER_SPOT)
		level.map_add_object_spot_ser(id, OFFER_SPOT, tr("szm_offer_hint"))
	end
end

---------------------------< Inventory marker >---------------------------
-- G.A.M.M.A.'s QoL Bundle (fetch_item_icon) puts the side-task icon in the corner of items wanted
-- by fetch tasks. Story items get the gold main-story icon the same way: every szm_ quest item,
-- and the item the active stage asks for (boar legs, cooked meat, the Jellyfish).
local function story_item_icon(cell, obj, sec)
	if not (sec and db.actor) then return end
	local wanted = string.find(sec, "^szm_") ~= nil
	if not wanted then
		for n, st in pairs(STAGES) do
			if st.fetch and st.fetch[1] == sec and get_task(n) then
				wanted = true
				break
			end
		end
	end
	if wanted then
		local axis = utils_xml.get_item_axis(sec)
		return { texture = "ui_inGame2_PDA_icon_Primary_mission", x = axis.w - 13, y = 1, w = 12, h = 12 }
	end
end

function on_game_start()
	RegisterScriptCallback("monster_on_loot_init", monster_on_loot_init)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_enemy_eval", on_enemy_eval)
	RegisterScriptCallback("physic_object_on_use_callback", physic_object_on_use_callback)
	RegisterScriptCallback("on_key_press", on_key_press)
	if rax_icon_layers and rax_icon_layers.register then
		rax_icon_layers.register("szm_story_item_icon", story_item_icon)
	end
end
