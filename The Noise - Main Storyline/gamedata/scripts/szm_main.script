-- The Noise (working title "Szum") - main storyline for a loner starting in the Cordon village.
-- Replaces Fanatic's "Training Day". Prefix: szm_
--
-- Prologue  1      : a garbled PDA message, Sid's lost courier
-- Act I     2-6    : Cordon, Sid's lessons (bandit, boars, Jellyfish + first Hum, campfire with Wolf), go to Spore
-- Act II    7-12   : Great Swamp, Spore's jobs, Cold, the helicopter wreck
-- Act III   13-15  : Sid decrypts the flight recorder, Garbage, the dead convoy in Agroprom
-- Act IV    16     : who gets the Kamerton: Cold, Sid or Wolf (destroy it)
-- Act V     17-27  : a day later the Noise is back; two stages for the chosen side (Cold 17-18, Sid 19-20,
--                    Wolf 21-22), then Agroprom's underground (23-24) and back to that side (25 / 26 / 27).
--                    Only the first Act V stage waits (ACT5_FIRST_DELAY_H): the radio call is a surprise after
--                    the "storyline complete" banner. The rest follows right away, offered in the report dialogs.
--
-- Every stage: offer dialog -> task stage 0 (objective) -> task stage 1 (report) -> turn-in dialog -> rewards
-- The next stage is offered only after the previous one has been turned in.

---------------------------< Spawn areas >---------------------------
-- Smart terrains with no fixed residents (see configs\misc\simulation.ltx)
CORDON_SMARTS = {   -- the village (2_12), the army checkpoint (3_16) and the 5_7 camp are left out
	"esc_smart_terrain_1_11", "esc_smart_terrain_2_14", "esc_smart_terrain_3_7",
	"esc_smart_terrain_4_9",  "esc_smart_terrain_4_11", "esc_smart_terrain_4_13",
	"esc_smart_terrain_5_2",  "esc_smart_terrain_5_4",  "esc_smart_terrain_5_6",
	"esc_smart_terrain_5_9",  "esc_smart_terrain_5_12", "esc_smart_terrain_6_6",
	"esc_smart_terrain_6_8",  "esc_smart_terrain_7_11", "esc_smart_terrain_8_9",
	"esc_smart_terrain_8_10", "esc_smart_terrain_9_7",  "esc_smart_terrain_9_10",
}
MARSH_SMARTS = {
	"mar_smart_terrain_10_10", "mar_smart_terrain_10_7", "mar_smart_terrain_3_10",
	"mar_smart_terrain_3_7",   "mar_smart_terrain_4_5",  "mar_smart_terrain_4_7",
	"mar_smart_terrain_6_10",  "mar_smart_terrain_6_4",  "mar_smart_terrain_6_7",
	"mar_smart_terrain_6_8",   "mar_smart_terrain_7_3",  "mar_smart_terrain_7_7",
	"mar_smart_terrain_8_4",   "mar_smart_terrain_8_8",  "mar_smart_terrain_8_9",
}
GARBAGE_SMARTS = {
	"gar_smart_terrain_1_5", "gar_smart_terrain_1_7", "gar_smart_terrain_2_4",
	"gar_smart_terrain_4_2", "gar_smart_terrain_4_5", "gar_smart_terrain_5_4",
	"gar_smart_terrain_5_5", "gar_smart_terrain_5_6", "gar_smart_terrain_6_1",
	"gar_smart_terrain_6_6", "gar_smart_terrain_6_7", "gar_smart_terrain_7_4",
	"gar_smart_terrain_8_5",
}
AGROPROM_SMARTS = {
	"agr_smart_terrain_2_2", "agr_smart_terrain_4_4_near_3", "agr_smart_terrain_4_6",
