		hum_on_fetch = "szm_hum_bandit",
		start_items = { {"wpn_toz34", 1, pristine = true, advance = true}, {"ammo_12x70_buck", 2, advance = true} },   -- Sid's advance for the job
		rewards = { {"novice_outfit", 1}, {"helm_respirator", 1} },   -- Leather Jacket + Refitted PBF: the weakest armor and gas mask
	},
	[5] = {  -- Jellyfish in the anomaly field; picking it up -> the Noise again
