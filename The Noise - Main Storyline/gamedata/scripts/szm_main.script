-- Who offers each stage: after a stage is turned in, this NPC gets a map spot until the next offer is accepted
OFFER_AT = {
	[2] = SID,   [3] = SID,   [4] = SID,   [5] = SID,   [6] = SID,
	[7] = SPORE, [8] = SPORE, [9] = SPORE, [10] = SPORE, [11] = SPORE,
	[12] = COLD, [13] = COLD,
	[14] = SID,  [15] = SID,
}
-- Gold like the story task markers (own type, defined in modxml_szm.script, so removing it
-- never takes away the task's own marker on the same NPC)
OFFER_SPOT = "szm_story_location"
OLD_OFFER_SPOT = "secondary_task_location"   -- used before; removed from our NPCs in older saves

-- Spawn smarts used by the last few stages are skipped, so consecutive tasks don't share a location
RECENT_SMARTS = 6

-- Act IV rewards; money/goodwill in tm_szm.ltx is common, the rest is here
