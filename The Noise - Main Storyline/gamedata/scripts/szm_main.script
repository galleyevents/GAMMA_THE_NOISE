-- Act V: offer dialogs (after the radio call) and report dialogs
local function can_offer_act5(n, first_speaker, second_speaker)
	if not has_alife_info(called_info(n)) or has_alife_info(done_info(n)) then return false end
	for i = 1, #STAGES do
		if get_task(i) then return false end
	end
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	local giver = stage_giver(STAGES[n])
	return npc ~= nil and giver ~= nil and get_object_story_id(npc:id()) == giver
end
