; Dead Channel - tasks. Auto-included by task_manager.ltx (#include "tm_*.ltx").
; Stage 0: objective, stage 1: report. Rewards and the story's branches are handled in dch_main.script;
; on_complete sets the stage's done info and cleans up its spawns. storyline = true: main story marker.

[dch_task_1]
icon                = ui_inGame2_PD_Torgovets_informatsiey
storyline           = true
title               = dch_task_1_name
descr_functor       = dch_descr_1
stage_complete      = 1
target_functor      = dch_target_1
status_functor      = dch_status_1
on_complete         = %+dch_stage_1_done =dch_cleanup(1)%
on_fail             = %=dch_cleanup(1)%

